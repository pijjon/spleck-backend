{
  "name": "spleck-backend",
  "version": "1.0.0",
  "description": "Express backend API for Spleck app",
  "homepage": "https://github.com/pijjon/spleck-backend#readme",
  "bugs": {
    "url": "https://github.com/pijjon/spleck-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pijjon/spleck-backend.git"
  },
  "license": "MIT",
  "author": "Alwin Zhao",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "tsx --watch --env-file .env src/index.ts",
    "start": "node --env-file .env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.15.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.17",
    "eslint": "^10.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  }
}